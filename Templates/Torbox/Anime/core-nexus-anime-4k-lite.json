      },
      {
        "expression": "/* CB Anime 4K A-Tier | 2160p WEB-DL HDR */ resolution(visualTag(quality(streams, 'WEB-DL'), 'HDR+DV', 'DV', 'HDR10+', 'HDR10', 'HDR'), '2160p')",
        "enabled": true
      },
      {
        "expression": "/* CB Anime 4K B-Tier | 2160p WEB-DL */ resolution(quality(streams, 'WEB-DL'), '2160p')",
