{
  "metadata": {
    "id": "core-stable-torbox-4k",
    "name": "Core Stable 4K · TorBox",
    "description": "Minimal, predictable 4K TorBox baseline. Uses local/native filtering, no remote SEL or regex sync, no fetch groups, and no dynamic early exit.",
    "source": "external",
    "author": "Branding-Brevity",
    "version": "1.0.0",
    "category": "Debrid",
    "serviceRequired": false,
    "setToSaveInstallMenu": true,
    "sourceUrl": "https://github.com/brevityA/Core-Builds",
    "changelogUrl": "https://raw.githubusercontent.com/brevityA/Core-Builds/refs/heads/main/CHANGELOG.md",
    "coreBuildsProfile": "stable",
    "coreBuildsProfileVersion": "1",
    "coreBuildsVersion": "2.89"
  },
