    "showChanges": true,
    "addonName": "Core Stable 4K · TorBox",
    "addonLogo": "https://raw.githubusercontent.com/brevityA/Core-Builds/refs/heads/main/Assets/core_icon.svg",
    "addonDescription": "Minimal, predictable 4K TorBox baseline. Uses local/native filtering, no remote SEL or regex sync, no fetch groups, and no dynamic early exit.",
    "preferredQualities": [
