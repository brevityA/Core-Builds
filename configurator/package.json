{
  "name": "core-builds-configurator",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080 -d src",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "test:e2e": "playwright test",
    "test:upstream-selector": "node scripts/run-upstream-selector-contract.mjs",
    "test:upstream-v232-nab": "node scripts/run-v232-nab-migration-contract.mjs",
    "validate:import-matrix": "node scripts/validate-import-matrix.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs --accept",
    "sync:upstream:check": "node scripts/sync-upstream.mjs --check",
    "release": "npm test && npm run validate && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2"
  }
}
