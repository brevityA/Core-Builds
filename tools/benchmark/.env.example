# Copy to tools/benchmark/.env (gitignored) and fill in. NEVER commit real values.
# Load with:  set -a; . tools/benchmark/.env; set +a
#
# Only THREE variables are required. runner.py exits with a "missing env" error
# if any of them is unset; everything else here is optional or lane-specific.

# ── required ────────────────────────────────────────────────────────────────

# The ONE AIOStreams instance every contender is benchmarked on. Must be
# reachable from wherever you run the harness. Include the scheme, no trailing
# slash: https://aiostreams.example.com
AIOS_INSTANCE_URL=

# Password used to create each benchmark config account on that instance via
# POST /api/v1/user. Use a throwaway value — it is not an existing account
# password, the harness creates new configs. 26 accounts will be created.
AIOS_CONFIG_PASSWORD=

# Debrid key for the lane being benchmarked. Only the lane you actually run
# needs a value; the variable name is chosen by AIOS_LANE (see LANE_ENV in
# runner.py). The default lane is torbox, so TORBOX_API_KEY is the usual one.
TORBOX_API_KEY=

# ── optional ────────────────────────────────────────────────────────────────

# Primary lane for headline results. Default: torbox.
# Supported: torbox | realdebrid | alldebrid | premiumize | debridlink |
#            easydebrid | offcloud
AIOS_LANE=torbox

# Other lanes. The current registry has 25 torbox contenders and 1 alldebrid,
# so ALLDEBRID_API_KEY is only needed to run that single cross-lane comparison.
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
PREMIUMIZE_API_KEY=
DEBRIDLINK_API_KEY=
EASYDEBRID_API_KEY=
OFFCLOUD_API_KEY=
