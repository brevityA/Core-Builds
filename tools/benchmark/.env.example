# Copy to tools/benchmark/.env (gitignored) and fill in. NEVER commit real values.
# Load with:  set -a; . tools/benchmark/.env; set +a

# The ONE AIOStreams instance every contender is benchmarked on.
AIOS_INSTANCE_URL=https://aiostreams.example.com

# Password used to create each benchmark config account on that instance.
AIOS_CONFIG_PASSWORD=

# Primary lane for headline results.
AIOS_LANE=torbox

# Debrid keys — only the lane(s) you actually run need a value.
TORBOX_API_KEY=
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
PREMIUMIZE_API_KEY=
DEBRIDLINK_API_KEY=
EASYDEBRID_API_KEY=
OFFCLOUD_API_KEY=

# Optional: metadata enrichment some templates expect.
TMDB_ACCESS_TOKEN=
